; ProjectVelocity — Godot 4.7.2. Edit through Project Settings when practical.
config_version=5

[application]
config/name="ProjectVelocity"
config/version="0.2.0-dev"
run/main_scene="res://core/bootstrap/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]
AppLogger="*res://core/logging/app_logger.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=1

[physics]
common/physics_ticks_per_second=60

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.045, 0.06, 1)

[debug]
file_logging/enable_file_logging=true
file_logging/log_path="user://logs/project_velocity.log"
file_logging/max_log_files=5

[internationalization]
locale/fallback="en"
locale/translations=PackedStringArray("res://ui/localization/bootstrap.en.translation", "res://ui/localization/bootstrap.ru.translation")
